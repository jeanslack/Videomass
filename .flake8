[flake8]
exclude = debian,
          develop,
          docs,
          requirements,
          tests,
          xdg,
          .git,
          __pycache__,
          build,
          dist,
          videomass/data
per-file-ignores=videomass/gui_app.py:F401
count = True
#select=E9,F63,F7,F82
max-line-length = 80
show-source = True
statistics = True
max-complexity = 15
ignore = F821, W503, C901
extend-ignore =
