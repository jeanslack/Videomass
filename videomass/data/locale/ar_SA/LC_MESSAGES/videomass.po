#: videomass/vdms_panels/audio_encoders/acodecs.py:262
msgid "Gets maximum volume and average volume data in dBFS, then calculates the offset amount for audio normalization."
msgstr "يحصل على بيانات أقصى مستوى للصوت ومتوسطه بوحدة dBFS، ثم يحسب مقدار الإزاحة اللازمة لتطبيع الصوت."

#: videomass/vdms_panels/audio_encoders/acodecs.py:265
msgid "Limiter for the maximum peak level or the mean level (when switch to RMS) in dBFS. From -99.0 to +0.0; default for PEAK level is -1.0; default for RMS is -20.0"
msgstr "حد أقصى لمستوى القمة أو لمستوى المتوسط (عند التبديل إلى RMS) بوحدة dBFS. من -99.0 إلى +0.0؛ الافتراضي لمستوى PEAK هو -1.0؛ والافتراضي لـ RMS هو -20.0"

#: videomass/vdms_panels/audio_encoders/acodecs.py:269
msgid ""
"\"Auto\", lets FFmpeg select the audio stream to process (usually the first audio stream). If the source file(s) is just an audio track, it's recommend to always set this control to \"Auto\".\n"
"\n"
"\"1-16\", if a video file contains more than one audio stream, you can select a specific one, e.g \"1\" for the first available audio stream, \"2\" for the second audio stream, and so on."
msgstr ""
"\"تلقائي\"، يترك لـ FFmpeg اختيار تدفق الصوت المراد معالجته (عادةً أول تدفق صوتي). إذا كان ملف المصدر مجرد مسار صوتي، يُنصح بضبط هذا التحكم دائمًا على \"تلقائي\".\n"
"\n"
"\"1-16\"، إذا كان ملف الفيديو يحتوي على أكثر من تدفق صوتي، يمكنك اختيار تدفق محدد، مثل \"1\" لأول تدفق صوتي متاح، و\"2\" للتدفق الصوتي الثاني، وهكذا."

#: videomass/vdms_panels/audio_encoders/acodecs.py:277
msgid ""
"\"Auto\" keeps all audio streams and processes only the one selected by the \"Index Selection\" control.\n"
"\n"
"\"All\" processes all audio streams with the properties of the one selected by the \"Index Selection\" control. Don't use \"All\" to export audio files from videos.\n"
"\n"
"\"Index Only\" processes only the audio stream selected by the \"Index Selection\" control and removes all others from the output video."
msgstr ""
"\"تلقائي\" يحتفظ بجميع تدفقات الصوت ويعالج فقط التدفق المحدد في عنصر التحكم \"اختيار الفهرس\".\n"
"\n"
"\"الكل\" يعالج جميع تدفقات الصوت بخصائص التدفق المحدد في عنصر التحكم \"اختيار الفهرس\". لا تستخدم \"الكل\" لتصدير ملفات صوتية من مقاطع الفيديو.\n"
"\n"
"\"الفهرس فقط\" يعالج فقط تدفق الصوت المحدد في عنصر التحكم \"اختيار الفهرس\" ويزيل جميع التدفقات الأخرى من فيديو الإخراج."

#: videomass/vdms_panels/audio_encoders/acodecs.py:286
msgid "Integrated Loudness Target in LUFS. From -70.0 to -5.0, default is -16.0"
msgstr "مستوى الجهارة المتكاملة المستهدف بوحدة LUFS. من -70.0 إلى -5.0، والافتراضي -16.0"

#: videomass/vdms_panels/audio_encoders/acodecs.py:289
msgid "Maximum True Peak in dBTP. From -1.5 to +0.0, default is -2.0"
msgstr "أقصى قمة حقيقية بوحدة dBTP. من -1.5 إلى +0.0، والافتراضي -2.0"

#: videomass/vdms_panels/audio_encoders/acodecs.py:292
msgid "Loudness Range Target in LUFS. From +1.0 to +20.0, default is +11.0"
msgstr "نطاق الجهارة المستهدف بوحدة LUFS. من +1.0 إلى +20.0، والافتراضي +11.0"

#: videomass/vdms_panels/audio_encoders/acodecs.py:295
msgid "Play the audio stream selected in the \"Index Selection\" control. Using this function you can test the result of audio normalization."
msgstr "تشغيل تدفق الصوت المحدد في عنصر التحكم \"اختيار الفهرس\". باستخدام هذه الوظيفة يمكنك اختبار نتيجة تطبيع الصوت."

