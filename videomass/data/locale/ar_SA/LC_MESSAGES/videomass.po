msgstr "إزالة التداخل بمرشح yadif"

#: videomass/vdms_dialogs/filter_deinterlace.py:98
msgid "Interlace"
msgstr "تداخل"

#: videomass/vdms_dialogs/filter_deinterlace.py:101
