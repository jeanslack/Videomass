#: videomass/vdms_dialogs/filter_deinterlace.py:57 videomass/vdms_panels/av_conversions.py:346
msgid "Deinterlace"
msgstr "Деинтерлейсинг"

#: videomass/vdms_dialogs/filter_deinterlace.py:61
