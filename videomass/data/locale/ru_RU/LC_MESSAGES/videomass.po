msgstr "Высота:"

#: videomass/vdms_dialogs/filter_scale.py:116
msgid "Constrain proportions (keep aspect ratio)"
msgstr "Сохраните пропорции (сохраните соотношение сторон)"

#: videomass/vdms_dialogs/filter_scale.py:121
msgid "Which dimension to adjust?"
msgstr "Какой размер отрегулировать?"

#: videomass/vdms_dialogs/filter_scale.py:130
msgid "Aspect Ratio"
msgstr "Пропорции"

#: videomass/vdms_dialogs/filter_scale.py:133
msgid "Setdar filter (display aspect ratio) example 16/9, 4/3 "
msgstr "Setdar (соотношение сторон экрана) "

#: videomass/vdms_dialogs/filter_scale.py:138 videomass/vdms_dialogs/filter_scale.py:172
msgid "Numerator"
msgstr "Числитель"

#: videomass/vdms_dialogs/filter_scale.py:163 videomass/vdms_dialogs/filter_scale.py:197
msgid "Denominator"
msgstr "Знаменатель"

#: videomass/vdms_dialogs/filter_scale.py:167
msgid "Setsar filter (sample aspect ratio) example 1/1"
msgstr "SetSar(примерное соотношение сторон)"

#: videomass/vdms_dialogs/filter_scale.py:218
msgid "Resize Tool"
msgstr "Инструмент изменения размера"

#: videomass/vdms_dialogs/filter_scale.py:219
msgid "Scale filter, set to 0 to disable"
msgstr "Масштабный фильтр, установите 0, чтобы отключить"

#: videomass/vdms_dialogs/filter_scale.py:222
msgid "Display Aspect Ratio. Set to 0 to disable"
msgstr "Соотношение сторон дисплея. Установите 0, чтобы отключить"

#: videomass/vdms_dialogs/filter_scale.py:225
msgid ""
"Sample (aka Pixel) Aspect Ratio.\n"
"Set to 0 to disable"
msgstr ""
"Образец (в пикселях) соотношения сторон.\n"
"Установите 0, чтобы отключить"

#: videomass/vdms_dialogs/filter_scale.py:372
msgid ""
"If you want to maintain the aspect ratio, select \"Constrain proportions\" below and specify only one dimension, width or height, and set the other dimension to -1 or -2.\n"
"\n"
"Setting the value to -1 will cause FFmpeg to calculate the perfect mathematical proportion, but without checking for divisibility.\n"
"\n"
"By setting the value to -2, you will tell FFmpeg to do exactly the same proportional calculation, but force the result to round to the nearest even number.\n"
"\n"
"Also note that some codecs strictly require -2, so you should do some testing first.\n"
"\n"
"Click the Help button for full documentation on this filter."
msgstr ""

#: videomass/vdms_dialogs/filter_stab.py:82
msgid "Enable stabilizer"
msgstr "Включить stabilizer"

