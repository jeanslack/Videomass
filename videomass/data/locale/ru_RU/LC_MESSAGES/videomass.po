msgid "90° (left)"
msgstr "90° (влево)"

#: videomass/vdms_dialogs/filter_transpose.py:98
msgid "90° (right)"
msgstr "90° (вправо)"

#: videomass/vdms_dialogs/filter_transpose.py:102
msgid "180°"
msgstr "180°"

#: videomass/vdms_dialogs/filter_transpose.py:123
msgid "Transpose Tool"
msgstr "Инструмент поворота кадра"

#: videomass/vdms_dialogs/filter_transpose.py:238
msgid "Rotate 90 degrees right"
msgstr "Повернуть на 90 градусов вправо"

#: videomass/vdms_dialogs/filter_transpose.py:260
